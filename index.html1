<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MediCare Hospital - Patient Management System</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #f4f7f6; color: #333; }
    .app-container { display: flex; min-height: 100vh; }
    .sidebar { width: 250px; background-color: #1a2530; color: #ffffff; display: flex; flex-direction: column; }
    .sidebar-brand { padding: 20px; font-size: 1.2rem; font-weight: bold; background-color: #111822; }
    .sidebar-menu { list-style: none; margin-top: 20px; }
    .sidebar-menu li { padding: 15px 20px; cursor: pointer; transition: 0.2s; }
    .sidebar-menu li:hover, .sidebar-menu li.active { background-color: #253545; border-left: 4px solid #00a8ff; }
    .main-content { flex: 1; display: flex; flex-direction: column; }
    .top-navbar { background-color: #ffffff; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .content-body { padding: 30px; flex: 1; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .stat-card { background: #ffffff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); display: flex; align-items: center; gap: 15px; }
    .stat-card .icon { width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem; }
    .stat-card.blue .icon { background: #e3f2fd; color: #1976d2; }
    .stat-card.green .icon { background: #e8f5e9; color: #388e3c; }
    .stat-card.purple .icon { background: #f3e5f5; color: #7b1fa2; }
    .stat-info h3 { font-size: 1.5rem; color: #222; }
    .stat-info p { font-size: 0.85rem; color: #666; }
    .controls-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 15px; flex-wrap: wrap; }
    .search-filter-group { display: flex; gap: 10px; flex: 1; }
    .search-input, .select-input { padding: 10px 15px; border: 1px solid #ccc; border-radius: 6px; outline: none; }
    .search-input { flex: 1; max-width: 300px; }
    .btn { padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; transition: 0.2s; }
    .btn-primary { background: #0084ff; color: white; }
    .btn-secondary { background: #6c757d; color: white; }
    .btn-danger { background: #dc3545; color: white; }
    .btn-info { background: #17a2b8; color: white; }
    .btn-warning { background: #ffc107; color: #212529; }
    .btn-sm { padding: 5px 10px; font-size: 0.8rem; margin-right: 5px; }
    .table-container { background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th, td { padding: 12px 15px; border-bottom: 1px solid #eee; }
    th { background-color: #f8f9fa; color: #555; font-weight: 600; }
    tr:hover { background-color: #f9f9f9; }
    .badge { padding: 4px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: bold; }
    .badge-admitted { background: #e8f5e9; color: #2e7d32; }
    .badge-discharged { background: #e3f2fd; color: #1565c0; }
    .alert { padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; }
    .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    .form-card { background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); max-width: 800px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    .form-group { display: flex; flex-direction: column; }
    .form-group label { margin-bottom: 6px; font-weight: 600; font-size: 0.9rem; color: #444; }
    .form-group input, .form-group select { padding: 10px; border: 1px solid #ccc; border-radius: 6px; outline: none; }
    .form-actions { display: flex; justify-content: flex-end; gap: 10px; }
  </style>
</head>
<body>
  <div id="root"></div>

  <!-- React Libraries -->
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <script type="text/babel">
    const API_URL = "http://localhost:8080/api/patients";

    function App() {
      const [activeTab, setActiveTab] = React.useState('dashboard');
      const [patients, setPatients] = React.useState([]);
      const [searchQuery, setSearchQuery] = React.useState('');
      const [filterDept, setFilterDept] = React.useState('All');
      const [filterStatus, setFilterStatus] = React.useState('All');
      const [selectedPatient, setSelectedPatient] = React.useState(null);
      const [alert, setAlert] = React.useState({ type: '', text: '' });

      const [formData, setFormData] = React.useState({
        name: '', age: '', gender: 'Male', phone: '',
        department: 'General Medicine', disease: '', doctor: '',
        admissionDate: '', status: 'Admitted'
      });

      const fetchPatients = async () => {
        try {
          const res = await fetch(API_URL);
          if (res.ok) {
            const data = await res.json();
            setPatients(data);
          }
        } catch (e) {
          showAlert('error', 'Backend not running. Showing local session data.');
        }
      };

      React.useEffect(() => { fetchPatients(); }, []);

      const showAlert = (type, text) => {
        setAlert({ type, text });
        setTimeout(() => setAlert({ type: '', text: '' }), 4000);
      };

      const handleInputChange = (e) => {
        setFormData({ ...formData, [e.target.name]: e.target.value });
      };

      const handleSubmit = async (e) => {
        e.preventDefault();
        try {
          const res = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
          });
          if (res.ok) {
            showAlert('success', 'Patient saved successfully!');
            fetchPatients();
            setActiveTab('patients');
          } else {
            showAlert('error', 'Error saving patient.');
          }
        } catch (err) {
          showAlert('error', 'Backend server offline!');
        }
      };

      return (
        <div className="app-container">
          <div className="sidebar">
            <div className="sidebar-brand">🏥 MediCare Hospital</div>
            <ul className="sidebar-menu">
              <li className={activeTab === 'dashboard' ? 'active' : ''} onClick={() => setActiveTab('dashboard')}>📊 Dashboard</li>
              <li className={activeTab === 'patients' ? 'active' : ''} onClick={() => setActiveTab('patients')}>👥 Patients</li>
              <li className={activeTab === 'add' ? 'active' : ''} onClick={() => setActiveTab('add')}>➕ Add Patient</li>
            </ul>
          </div>

          <div className="main-content">
            <div className="top-navbar">
              <h2>Hospital Management System</h2>
              <div>👤 <strong>Admin</strong></div>
            </div>

            <div className="content-body">
              {alert.text && <div className={`alert alert-${alert.type}`}>{alert.text}</div>}

              {activeTab === 'dashboard' && (
                <div>
                  <div className="stats-grid">
                    <div className="stat-card blue"><div className="icon">👥</div><div className="stat-info"><h3>{patients.length}</h3><p>Total Patients</p></div></div>
                    <div className="stat-card green"><div className="icon">🛏️</div><div className="stat-info"><h3>{patients.filter(p => p.status === 'Admitted').length}</h3><p>Admitted</p></div></div>
                    <div className="stat-card purple"><div className="icon">✅</div><div className="stat-info"><h3>{patients.filter(p => p.status === 'Discharged').length}</h3><p>Discharged</p></div></div>
                  </div>
                </div>
              )}

              {activeTab === 'add' && (
                <div className="form-card">
                  <h3>Add New Patient</h3>
                  <form onSubmit={handleSubmit} style={{marginTop: '20px'}}>
                    <div className="form-grid">
                      <div className="form-group"><label>Name</label><input type="text" name="name" required value={formData.name} onChange={handleInputChange} /></div>
                      <div className="form-group"><label>Age</label><input type="number" name="age" required value={formData.age} onChange={handleInputChange} /></div>
                      <div className="form-group">
                        <label>Gender</label>
                        <select name="gender" value={formData.gender} onChange={handleInputChange}>
                          <option value="Male">Male</option><option value="Female">Female</option>
                        </select>
                      </div>
                      <div className="form-group"><label>Phone</label><input type="text" name="phone" required value={formData.phone} onChange={handleInputChange} /></div>
                      <div className="form-group"><label>Disease</label><input type="text" name="disease" required value={formData.disease} onChange={handleInputChange} /></div>
                      <div className="form-group"><label>Doctor Assigned</label><input type="text" name="doctor" required value={formData.doctor} onChange={handleInputChange} /></div>
                      <div className="form-group"><label>Admission Date</label><input type="date" name="admissionDate" required value={formData.admissionDate} onChange={handleInputChange} /></div>
                    </div>
                    <div className="form-actions">
                      <button type="submit" className="btn btn-primary">Save Patient Record</button>
                    </div>
                  </form>
                </div>
              )}
            </div>
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
